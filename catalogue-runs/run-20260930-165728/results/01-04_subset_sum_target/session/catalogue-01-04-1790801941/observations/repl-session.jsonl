_meta":null,"parsed":{"kind":"RESULT","body":"#!/usr/bin/env python3\nS = [3, 34, 7, 12, 5, 26, 11, 8, 15, 2, 19, 21]\nT = 40\nsolutions = []\n\ndef backtrack(idx, current, total):\n    if total == T:\n        solutions.append(list(current))\n        return\n    if total > T or idx == len(S):\n        return\n    # include current element\n    current.append(S[idx])\n    backtrack(idx + 1, current, total + S[idx])\n    current.pop()\n    # exclude current element\n    backtrack(idx + 1, current, total)\n\nbacktrack(0, [], 0)\n\nfor sol in solutions:\n    print(sol, sum(sol))\nprint(\"Total solutions:\", len(solutions))\n\nimport json\nwitness = {\"polarity\": \"positive\", \"evidence\": {\"path\": \"execution://witness\"}, \"data\": {\"solutions\": solutions, \"total\": len(solutions)}}\nprint(\"WITNESS:\", json.dumps(witness))","expected_type":null,"description":null,"result_ir":{"files":[{"filename":"subset_sum_backtrack.py","satisfies":["R1","R2","R3","R4"],"evidence":{"path":"execution://body","section":null,"observed":null}}],"reconciliation":[{"requirement":"R1","status":"satisfied","evidence":{"path":"execution://body","section":null,"observed":"Find all subsets of the set S = {3, 34, 7, 12, 5, 26, 11, 8, 15, 2, 19, 21} that sum exactly to the target T = 40."}},{"requirement":"R2","status":"satisfied","evidence":{"path":"execution://body","section":null,"observed":"Use a backtracking algorithm that explores the full search tree."}},{"requirement":"R3","status":"satisfied","evidence":{"path":"execution://body","section":null,"observed":"Emit the subset and VERIFY its sum."}},{"requirement":"R4","status":"satisfied","evidence":{"path":"execution://body","section":null,"observed":"Report the total number of solutions."}}],"open_defects":[],"witness":{"polarity":"positive","evidence":{"path":"execution://witness","section":null,"observed":null},"data":{"solutions":"[[list of subsets]]","total":"<number>"},"domain":null,"provisional":null}}},"parse_error":null}],"